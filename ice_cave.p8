version 43
__lua__
--ice cave
--justin montgomery
--20260708

function _init()
	lvl    = 1 
	speed  = .6
	t_plr  = 1
	t_bld  = 2
	t_flr  = 3
	t_ice  = 4
	t_hol  = 5
	t_rdir = {[6]={x=1,y=0},[7]={x=0,y=-1},[8]={x=-1,y=0},[9]={x=0,y=1}}
	
	fall_timer  = 0 
	plr    = {sp=t_plr,st='norm',hp=3,x=5,y=11,visx=5*8,visy=11*8,last={x=0,y=0},v={x=0,y=0}}
	blds        = {}
	bld_changes = {}
	
	load_level(lvl)
	
	------debug-------
	last_change = ""
end

function _update()
 plr_inp()
 move(plr)
 for k,v in pairs(blds) do
 	move(v)
 end
 smooth_move()
 update_blds()
end

function _draw()
 cls()
 map(0,0,0,0,127,127)
 if plr.st == 'norm' or plr.st == 'slide' then
  spr(plr.sp,plr.visx,plr.visy)
 end
 
 for k,v in pairs(blds) do
  if v.st == 'norm' or v.st == 'slide' then
 	 spr(v.sp,v.visx,v.visy)
 	end
 end
 
 ---------debug----------
 if hit then
 	--print('hit',24,96,0)
 end
 local key = '1,11'
 local sb  = blds[key]
 print(last_change,2,104,0)
 print(pushlog,2,112,0)
 if sb then
 	print('bld:x='..sb.x..','..'y='..sb.y,2,120,0)
 end
end
-->8
--map
function load_level()
	for i = (lvl-1),(lvl+15) do
		for j = (lvl-1),(lvl+15) do
			
			local t = mget(i,j)  
			if t == t_bld then
				mset(i,j,t_flr)
				mk_bld(i,j)
			end
			
		end
	end
end
-->8
--objects
function mk_bld (_x,_y)
	local bld = {}
	bld.x   = _x
	bld.y   = _y
	bld.visx= _x*8
	bld.visy= _y*8
	bld.sp  = t_bld
	bld.v   = {x=0,y=0}
	bld.st  = 'norm'
	
	local key = (_x) .. "," .. (_y)
	blds[key] = bld
end

function update_blds()
	for i in all(bld_changes) do
	 last_change = i.old .. " -> " .. i.new
		local bld   = i.bld
		blds[i.old] = nil
		if bld.st ~= 'gone' then
	  blds[i.new] = bld
	 end
	end
	bld_changes = {}
end


-->8
--movement
function plr_inp()
 if plr.st == 'norm' or (plr.st == 'slide' and plr.v.x == 0 and plr.v.y == 0) then
		if btnp(⬆️) then
			plr.v.y = -1
		
		elseif btnp(⬇️) then
		 plr.v.y = 1
		
		elseif btnp(⬅️) then
			plr.v.x = -1
		
		elseif btnp(➡️) then
			plr.v.x = 1
		end
	end
end

function move(_o)
	local cx  = _o.x
	local cy  = _o.y
	local nx  = cx + _o.v.x
	local ny  = cy + _o.v.y
	local mv  = can_move(nx,ny)	
	local key = nx..','..ny
	
	if _o.sp == t_plr then
		if blds[key] then
		 if  _o.st ~= 'slide' then
	   local nbx   = blds[key].x + plr.v.x
	   local nby   = blds[key].y + plr.v.y
	   local b_mv  = can_move(nbx,nby)
	   if b_mv and not blds[nbx..','..nby] then
	    push_bld(nx,ny,_o.v) 
	    _o.v.x,_o.v.y = 0,0
	   else
	    _o.v.x,_o.v.y = 0,0
	   end
	  elseif _o.st == 'slide' then
	   _o.v.x,_o.v.y = 0,0
	  end
		elseif mv == t_flr then
			cx,cy = nx,ny
			_o.last.x,_o.last.y = cx,cy
			if fall_timer > 0 then
				fall_timer -= 1
			else
				_o.st = 'norm'
			end
			_o.v.x,_o.v.y = 0,0
  elseif mv == t_ice then
   cx,cy = nx,ny
   _o.st = 'slide'
  elseif mv == t_hol then
   cx,cy = nx,ny
   _o.v.x,_o.v.y = 0,0
   fall_in_hole(_o)
  elseif t_rdir[mv] then
   cx,cy = nx,ny
   redirect(_o,t_rdir[mv])
  else
   --bump sound
   _o.v.x,_o.v.y = 0,0
		end
		
		
	elseif _o.sp == t_bld then
	 
			local ckey = cx .. ',' .. cy
			local nkey = nx .. ',' .. ny
	
				if blds[nkey] then
					 hit = true
					 _o.v.x,_o.v.y = 0,0
				elseif mv == t_flr then
					cx,cy = nx,ny
					_o.st = 'norm'
					_o.v.x,_o.v.y = 0,0
		  elseif mv == t_ice then
		   cx,cy = nx,ny
		   _o.st = 'slide'
		  elseif mv == t_hol then
		   cx,cy = nx,ny
		   fall_in_hole(_o,cx,cy)
		   _o.v.x,_o.v.y = 0,0
		  elseif t_rdir[mv] then
		   cx,cy = nx,ny
		  else
		   --bump sound
				end
			
			if _o.x ~= cx or _o.y ~= cy then
			 add(bld_changes,{old=ckey, new=nkey, bld=_o})		
			end
		end
	
	if _o.st ~= 'gone' then
	 _o.x,_o.y = cx,cy
 end
end

function can_move(_x,_y)
	local t = mget(_x,_y)
	if t == t_ice or t == t_bld or t == t_hol or t_rdir[t] or t == t_flr then
  return t
 else 
  return false		
	end
end

function smooth_move()
 if abs(plr.visx - plr.x*8) > 1 and plr.st == 'falling' then
  plr.st = 'gone'
 end
	plr.visx = plr.visx + ((plr.x*8)-plr.visx)*speed
	plr.visy = plr.visy + ((plr.y*8)-plr.visy)*speed
	
	for k,v in pairs(blds) do
	 if abs(v.visx - v.x*8) > 1 and v.st == 'falling' then
   v.st = 'gone'
  end		
		v.visx = v.visx + ((v.x*8)-v.visx)*speed
		v.visy = v.visy + ((v.y*8)-v.visy)*speed
	 
	end
 
end
-->8
--tile effects
function push_bld(_x,_y,_v)
	local key = _x .. "," .. _y
	pushlog = 'push_v:'.._v.x..','.._v.y
	blds[key].v.x = _v.x
	blds[key].v.y = _v.y
end

function fall_in_hole(_o,_x,_y)
  fall_timer = 30
 	_o.st = 'gone'
		if _o.sp == t_plr then
		 plr.x,plr.y = plr.last.x,plr.last.y
		elseif _o.sp == t_bld then
			blds[_x..','.._y] = nil
		end
end

function redirect(_o,_v)
	_o.v.x = _v.x
	_o.v.y = _v.y
end

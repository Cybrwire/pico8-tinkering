function _init()
	lvl    = 1 
	t_plr  = 1
	t_bld  = 2
	t_flr  = 3
	t_ice  = 4
	t_hol  = 5
	t_rdir = 6
	
	plr  = {sp=t_plr,st='norm',hp=3,stx=4,sty=4,ckpt,v={x=0,y=0}}
	blds = {}
	load_level(lvl)
end

function _update()

end

function _draw()
 cls()
 map(0,0,0,0,127,127)
 for k,v in pairs(blds) do
 	spr(v.sp,v.x,v.y)
 end
end
-->8
--map
function load_level()
	for i = (lvl-1),(lvl+15) do
		for j = (lvl-1),(lvl+15) do
			
			local t = mget(i,j)  
			if t == t_bld then
				mset(i,j,t_flr)
				mk_bld(i,j)
			end
			
		end
	end
end
-->8
--objects
function mk_bld (_x,_y)
	local bld = {}
	bld.x   = _x * 8
	bld.y   = _y * 8
	bld.sp  = t_bld
	bld.v   = {x=0,y=0}
	
	local key = (_x*8) .. "," .. (_y*8)
	
	blds[key] = bld
end

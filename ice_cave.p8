--ice cave
--justin montgomery
--20260708

function _init()
	lvl    = 1 
	speed  = 1
	t_plr  = 1
	t_bld  = 2
	t_flr  = 3
	t_ice  = 4
	t_hol  = 5
	t_rdir = {[6]={x=1,y=0},[7]={x=0,y=-1},[8]={x=-1,y=0},[9]={x=0,y=1}}
	
	fall_timer  = 0 
	plr    = {sp=t_plr,st='norm',hp=3,x=1,y=3,last={x=0,y=0},v={x=0,y=0}}
	blds        = {}
	bld_changes = {}
	
	load_level(lvl)
end

function _update()
 plr_inp()
 move(plr)
 for k,v in pairs(blds) do
 	move(v)
 end
 update_blds()
end

function _draw()
 cls()
 map(0,0,0,0,127,127)
 if plr.st == 'norm' or plr.st == 'slide' then
  spr(plr.sp,plr.x*8,plr.y*8)
 end
 
 for k,v in pairs(blds) do
 	spr(v.sp,v.x*8,v.y*8)
 end
 
 ---------debug----------
 if hit then
 	print('hit',24,96,0)
 end
 print(plr.last.x,2,104,0)
 print(plr.last.y,2,112,0)
 print(plr.st,2,96,0)
 
end
-->8
--map
function load_level()
	for i = (lvl-1),(lvl+15) do
		for j = (lvl-1),(lvl+15) do
			
			local t = mget(i,j)  
			if t == t_bld then
				mset(i,j,t_flr)
				mk_bld(i,j)
			end
			
		end
	end
end
-->8
--objects
function mk_bld (_x,_y)
	local bld = {}
	bld.x   = _x
	bld.y   = _y
	bld.sp  = t_bld
	bld.v   = {x=0,y=0}
	
	local key = (_x) .. "," .. (_y)
	
	blds[key] = bld
end

function update_blds()
	for i in all(bld_changes) do
		bld        = i.bld
	 blds[i.old] = nil
	 blds[i.new] = bld
	end
end
-->8
--movement
function plr_inp()
 if plr.st == 'norm' then
		if btnp(⬆️) then
			plr.v.y = -speed
		end
		if btnp(⬇️) then
		 plr.v.y = speed
		end
		if btnp(⬅️) then
			plr.v.x = -speed
		end
		if btnp(➡️) then
			plr.v.x = speed
		end
	end
end

function move(_o)
	local cx  = _o.x
	local cy  = _o.y
	local nx  = cx + _o.v.x
	local ny  = cy + _o.v.y
	local mv  = can_move(nx,ny)	
	local key = nx..','..ny
	
	if _o.sp == t_plr then
		if blds[key] and _o.st ~= 'slide' then
   push_bld(nx,ny,_o.v)
		elseif mv == t_flr then
			cx,cy = nx,ny
			_o.last.x,_o.last.y = cx,cy
			if fall_timer > 0 then
				fall_timer -= 1
			else
				_o.st = 'norm'
			end
			_o.v.x,_o.v.y = 0,0
  elseif mv == t_ice then
   cx,cy = nx,ny
   _o.st = 'slide'
  elseif mv == t_hol then
   cx,cy = nx,ny
   _o.v.x,_o.v.y = 0,0
   fall_in_hole(_o)
  elseif t_rdir[mv] then
   cx,cy = nx,ny
   redirect(_o,t_rdir[mv])
  else
   --bump sound
		end
	elseif _o.sp == t_bld then
		local ckey = cx .. ',' .. cy
		local nkey = nx .. ',' .. ny
  
		if mv == t_flr then
			cx,cy = nx,ny
			_o.st = 'norm'
			_o.v.x,_o.v.y = 0,0
  elseif mv == t_ice then
   cx,cy = nx,ny
   _o.st = 'slide'
  elseif mv == t_hol then
   cx,cy = nx,ny
  	_o.v.x,_o.v.y = 0,0
   fall_in_hole(_o)
  else
   --bump sound
		end
		add(bld_changes,{old=ckey, new=nkey, bld=_o})		
		
	end
	if _o.st ~= 'gone' then
	 _o.x,_o.y = cx,cy
 end
end

function can_move(_x,_y)
	local t = mget(_x,_y)
	if t == t_ice or t == t_bld or t == t_hol or t_rdir[t] or t == t_flr then
  return t
 else 
  return false		
	end
end
-->8
--tile effects
function push_bld(_x,_y,_v)
	local key = _x .. "," .. _y
	blds[key].v.x = _v.x
	blds[key].v.y = _v.y
end

function fall_in_hole(_o)
  fall_timer = 30
 	_o.st = 'gone'
		if _o.sp == t_plr then
		 plr.x,plr.y = plr.last.x,plr.last.y
		end
end

function redirect(_o,_v)
	_o.v.x = _v.x
	_o.v.y = _v.y
end

pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--ice cave
--justin montgomery
--20260708

function _init()
 camx, camy = 0,0
	lvl    = 1 
	speed  = .6
	t_plr  = 1
	t_bld  = 2
	t_flr  = 3
	t_ice  = 4
	t_hol  = 5
	t_rdir = {[6]={x=1,y=0},[7]={x=0,y=-1},[8]={x=-1,y=0},[9]={x=0,y=1}}
	t_door = {[10]=true,[11]=true,[12]=true,[13]=true}
	
	fall_timer  = 0 
	start_pos={{2,5},{13,4},{5,5}}
	plr    = {
	sp=t_plr,
	prv_st='',
	st='norm',
	hp=3,
	spd=speed,
	x=start_pos[lvl][1],
	y=start_pos[lvl][2],
	visx=start_pos[lvl][1]*8,
	visy=start_pos[lvl][2]*8,
	last={x=0,y=0},
	v={x=0,y=0}
	}
	blds        = {}
	bld_changes = {}
	load_lvl(lvl)
end

function _update()
 plr_inp()
 if plr.st ~= 'gone'then move(plr) end
 for k,v in pairs(blds) do
 	move(v)
 end
 smooth_move()
 update_blds()
 audio_update()
 state_update()
 check_lvl_win()
end

function _draw()
 cls()
 camera(camx,camy)
 map(0,0)
 if plr.st == 'norm' or plr.st == 'slide' or plr.st == 'trans' then
  spr(plr.sp,plr.visx,plr.visy,1,1,last_dir)
 end
 
 for k,v in pairs(blds) do
  if v.st == 'norm' or v.st == 'slide' then
 	 spr(v.sp,v.visx,v.visy)
 	end
 end
 
end
-->8
--map
function load_lvl(lvl)

 local col = (lvl-1) %8
 local row = flr((lvl-1)/8)
 camx = col *128
 camy = row *128
 
	for i = (lvl-1)*16,(lvl-1)*16+15 do
		for j = 0,16-1 do
			
			local t = mget(i,j)  
			if t == t_bld then
				mset(i,j,t_flr)
				mk_bld(i,j)
			end
			
		end
	end
	
	plr.x    = start_pos[lvl][1]+col*16
	plr.y    = start_pos[lvl][2]+row*16
	plr.visx = plr.x*8
	plr.visy = plr.y*8
	plr.st   = 'norm' 
	win = false
end

function check_lvl_win()
	if win ~= true and t_door[mget(plr.x,plr.y)] then
		lvl +=1
	 plr.st = 'trans'
		win = true
		load_lvl(lvl)
	end
end
-->8
--objects
function mk_bld (_x,_y)
	local bld = {}
	bld.x   = _x
	bld.y   = _y
	bld.visx= _x*8
	bld.visy= _y*8
	bld.sp  = t_bld
	bld.v   = {x=0,y=0}
	bld.st  = 'norm'
	bld.spd = speed
	
	local key = (_x) .. "," .. (_y)
	blds[key] = bld
end

function update_blds()
	for i in all(bld_changes) do
	 last_change = i.old .. " -> " .. i.new
		local bld   = i.bld
		blds[i.old] = nil
		if bld.st ~= 'gone' then
	  blds[i.new] = bld
	 end
	end
	bld_changes = {}
end


-->8
--movement
function plr_inp()
 if plr.st == 'norm' or (plr.st == 'slide' and plr.v.x == 0 and plr.v.y == 0) then
		if btnp(⬆️) then
			plr.v.y = -1
		
		elseif btnp(⬇️) then
		 plr.v.y = 1
		
		elseif btnp(⬅️) then
			plr.v.x = -1
		 last_dir = true
		elseif btnp(➡️) then
			plr.v.x = 1
			last_dir = false

		end
	end
end

function move(_o)
	local cx  = _o.x
	local cy  = _o.y
	local nx  = cx + _o.v.x
	local ny  = cy + _o.v.y
	local mv  = can_move(nx,ny)	
	local key = nx..','..ny
	
	if _o.sp == t_plr then
		if blds[key] then
		 if  _o.st ~= 'slide' then
	   local nbx   = blds[key].x + plr.v.x
	   local nby   = blds[key].y + plr.v.y
	   local b_mv  = can_move(nbx,nby)
	   if b_mv and not blds[nbx..','..nby] and mget(cx,cy) ~= t_ice then
	    push_bld(nx,ny,_o.v) 
	    _o.v.x,_o.v.y = 0,0
	   else
	    sfx(00)
	    _o.v.x,_o.v.y = 0,0
	   end
	  elseif _o.st == 'slide' then
	   _o.v.x,_o.v.y = 0,0
	  end
		elseif mv == t_flr then
			cx,cy = nx,ny
			_o.last.x,_o.last.y = cx,cy
			_o.prv_st = _o.st
			_o.st     = 'norm'
			_o.v.x,_o.v.y = 0,0
  elseif mv == t_ice then
   cx,cy = nx,ny
   _o.prv_st = _o.st
   if mget(plr.x,plr.y) == t_ice and plr.v.x == 0 and plr.v.y == 0 then
    _o.st  = 'norm' 
   else
    _o.st  = 'slide'
   end
  elseif mv == t_hol then
   cx,cy = nx,ny
   _o.v.x,_o.v.y = 0,0
   fall_in_hole(_o)
  elseif t_rdir[mv] then
   cx,cy = nx,ny
   redirect(_o,t_rdir[mv])
  elseif t_door[mv] then
   cx,cy = nx,ny
   _o.v.x,_o.v.y = 0,0
  else
   sfx(00)
   _o.v.x,_o.v.y = 0,0
		end
		
		
	elseif _o.sp == t_bld then
	 
			local ckey = cx .. ',' .. cy
			local nkey = nx .. ',' .. ny
	
				if blds[nkey] then
					_o.v.x,_o.v.y = 0,0
				elseif mv == t_flr then
					cx,cy = nx,ny
					_o.st = 'norm'
					_o.v.x,_o.v.y = 0,0
		  elseif mv == t_ice then
		   cx,cy = nx,ny
		   _o.st = 'slide'
		  elseif mv == t_hol then
		   cx,cy = nx,ny
		   fall_in_hole(_o,cx,cy)
		   _o.v.x,_o.v.y = 0,0
		  elseif t_rdir[mv] then
		   cx,cy = nx,ny
		  else
		   --bump sound
				end
			
			if _o.x ~= cx or _o.y ~= cy then
			 add(bld_changes,{old=ckey, new=nkey, bld=_o})		
			end
		end
	
	if _o.st ~= 'gone' and _o.st ~= 'trans' then
	 _o.x,_o.y = cx,cy
 end
end

function can_move(_x,_y)
	local t = mget(_x,_y)
	if t == t_ice or t == t_bld or t == t_hol or t_rdir[t] or t == t_flr or t_door[t] then 
  return t
 else 
  return false		
	end
end

function smooth_move()
 
	plr.visx = plr.visx + ((plr.x*8)-plr.visx)*speed
	plr.visy = plr.visy + ((plr.y*8)-plr.visy)*speed
	
	for k,v in pairs(blds) do		
		v.visx = v.visx + ((v.x*8)-v.visx)*speed
		v.visy = v.visy + ((v.y*8)-v.visy)*speed 
	end
 
end
-->8
--tile effects
function push_bld(_x,_y,_v)
	local key = _x .. "," .. _y
	blds[key].v.x = _v.x
	blds[key].v.y = _v.y
	sfx(01)
end

function fall_in_hole(_o,_x,_y)
  fall_timer = 30
 	_o.st = 'trans'
		if _o.sp == t_plr then
		 plr.x,plr.y = plr.last.x,plr.last.y
		elseif _o.sp == t_bld then
			blds[_x..','.._y] = nil
		end
end

function redirect(_o,_v)
	_o.v.x = _v.x
	_o.v.y = _v.y
end
-->8
--updates
function audio_update()
	if plr.st == 'slide' and plr.prv_st ~= 'slide' then
  if stat(16) == -1 then
  	sfx(02,0,nil,6)
  end
	end
end

function state_update()
	if abs(plr.visx - plr.x*8) < 1 and abs(plr.visy - plr.y*8) < 1 and plr.st == 'trans' then
  plr.st = 'gone'
 end
 
 for k,v in pairs(blds) do
	 if abs(v.visx - v.x*8) > 1 and v.st == 'trans' then
   v.st = 'gone'
  end
 end
 
 if fall_timer > 0 and plr.st == 'gone' then
  fall_timer -=1 
 elseif plr.st == 'gone' and fall_timer == 0 then
  plr.st = 'norm'	
 end
end

__lua__
--ice cave
--justin montgomery
--20260708

function _init()
	lvl    = 1 
	speed  = 1
	t_plr  = 1
	t_bld  = 2
	t_flr  = 3
	t_ice  = 4
	t_hol  = 5
	t_rdir = 6
	
	plr  = {sp=t_plr,st='norm',hp=3,x=1,y=1,ckpt,v={x=0,y=0}}
	blds = {}
	load_level(lvl)
end

function _update()
 plr_inp()
 move(plr)
 for k,v in pairs(blds) do
 	move(v)
 end
end

function _draw()
 cls()
 map(0,0,0,0,127,127)
 spr(plr.sp,plr.x*8,plr.y*8)
 for k,v in pairs(blds) do
 	print('bld: '..k,2,2,0)
 	spr(v.sp,v.x*8,v.y*8)
 end
 
 ---------debug----------
 --rectfill(10,10,110,10,0)
 print("xvect ".. plr.v.x,100,2,0)
 print("yvect ".. plr.v.y,100,10,0)
end
-->8
--map
function load_level()
	for i = (lvl-1),(lvl+15) do
		for j = (lvl-1),(lvl+15) do
			
			local t = mget(i,j)  
			if t == t_bld then
				mset(i,j,t_flr)
				mk_bld(i,j)
			end
			
		end
	end
end
-->8
--objects
function mk_bld (_x,_y)
	local bld = {}
	bld.x   = _x 
	bld.y   = _y 
	bld.sp  = t_bld
	bld.v   = {x=0,y=0}
	
	local key = (_x) .. "," .. (_y)
	
	blds[key] = bld
end
-->8
--movement
function plr_inp()
	plr.v.x = 0
	plr.v.y = 0
	if btnp(⬆️) then
		plr.v.y = -speed
	end
	if btnp(⬇️) then
	 plr.v.y = speed
	end
	if btnp(⬅️) then
		plr.v.x = -speed
	end
	if btnp(➡️) then
		plr.v.x = speed
	end
end

function move(_o)
	local cx  = _o.x
	local cy  = _o.y
	local nx  = cx + _o.v.x
	local ny  = cy + _o.v.y
	local mv  = can_move(nx,ny)
	local key = nx .. ',' .. ny
	
	if _o.sp == t_plr then
		if mv == t_flr then
			cx,cy = nx,ny
			_o.st = 'norm'
		elseif blds[key] and _o.st ~= 'slide' then
   push_bld(nx,ny,_o.v)
  elseif mv == t_ice then
   cx,cy = nx,ny
   _o.st = 'slide'
  elseif mv == t_hol then
   cx,cy = nx,ny
   fall_in_hole(_o)
  elseif mv == t_rdir then
   cx,cy = nx,ny
   redirect(_o)
  else
   --bump sound
		end
	end
	_o.x,_o.y = cx,cy
end

function can_move(_x,_y)
	local t = mget(_x,_y)
	if t == t_ice or t == t_bld or t == t_hol or t == t_rdir or t == t_flr then
  return t
 else 
  return false		
	end
end
-->8
--tile effects
function push_bld(_x,_y,_v)
	print('push!',2,2,0)
	local key = _x .. "," .. _y
	blds[key].v.x = _v.x
	blds[key].v.y = _v.y
end

pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- game loop
function _init()
	map_setup()
	make_player()
	anim_setup()
end

function _update()
	
	move_player()
	update_anim()
end

function _draw()
	cls()
	draw_map()
	draw_player()
end
-->8
--map code
function map_setup()
	--tile settings
	
end

function draw_map()	
	map(0,0,0,0,64,64)
end

function is_tile(tile_type,x,y)
	tile=mget(x,y)
	has_flag=fget(tile,tile_type)
	return has_flag
end

function can_move(x,y)
	return not is_tile(wall,x,y)
end
-->8
--player code
function make_player()
	p={}
	p.x=2
	p.y=2
	p.sprite=1
	p.speed=1
end

function draw_player()
	spr(frames[flr(p.sprite)],p.x,p.y,2,2)
end

function move_player()
	newx=p.x
	newy=p.y
	
	if (btnp(⬅️)) newx-=p.speed
	if (btnp(➡️)) newx+=p.speed
	if (btnp(⬆️)) newy-=p.speed
	if (btnp(⬇️)) newy+=p.speed
	
	if (can_move(newx,newy)) then
		p.x=mid(0,newx,63)
		p.y=mid(0,newy,63)
	end

end
-->8
--animation code
function anim_setup()
	speed=.1
	frames={3,5}
end

function update_anim()
	if (p.sprite<(#frames+1)-speed) then
		p.sprite+=speed
	else
		p.sprite=1
	end	
end


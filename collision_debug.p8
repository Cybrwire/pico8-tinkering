pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	p={x=4,y=5,w=1,h=1}
	bug="none"
end

function _update()
	move_player()
end

function _draw()
	cls()
	map()
	spr(1,p.x*8,p.y*8)
	_debug()
end
-->8
function move_player()
	local speed=.1
	local newx=p.x
	local newy=p.y
	if btn(0) and btn(2)
	or btn(0) and btn(3)
	or btn(1) and btn(2)
	or btn(1) and btn(3) then
		diag=true
	else 
		diag=false
	end
	
	
	if btn(0) then
		newx-=speed
		dir="left"
	end
	if btn(1) then
		newx+=speed
		dir="right"
	end
	if btn(2) then
		newy-=speed
		dir="up"
	end
	if btn(3) then
		newy+=speed
		dir="down"
	end
	
	if not is_collide(p,dir,diag) then
		p.x=newx p.y=newy
		bug="collide: false"
	else
		bug="collide: true"
	end
	
end

function is_collide(obj,dir,diagonal)
	--object to move
	local x=obj.x*8 local y=obj.y*8
	local w=obj.w*8 local h=obj.h*8
	--collision test rectangle
	local x1,x2,y1,y2=0,0,0,0
	
	if dir=="left" then
		x1=x-1   y1=y
		x2=x     y2=y+h-1
		tx1,ty1,tx2,ty2=x1,y1,x2,y2
	end
	if dir=="right" then
		x1=x+w-1 y1=y
		x2=x+w   y2=y+h-1
		tx1,ty1,tx2,ty2=x1,y1,x2,y2
	end
 if dir=="up" then
		x1=x     y1=y-1
		x2=x+w-1 y2=y
		tx1,ty1,tx2,ty2=x1,y1,x2,y2
	end
	if dir=="down" then
		x1=x   y1=y+h
		x2=x+w y2=y+h
		tx1,ty1,tx2,ty2=x1,y1,x2,y2
	end
	x1/=8 y1/=8
	x2/=8 y2/=8
	
	if fget(mget(x1,y1),0) 
	or fget(mget(x1,y2),0) 
	or fget(mget(x2,y1),0) 
	or fget(mget(x2,y2),0) then
		return true
	else
		return false
	end
end

function _debug()
	print(bug,10,1,7)
	print("dir: "..tostr(dir),10,9,7)
	print("diag: "..tostr(diag),10,17,7)
	--draw hitbox
	rect(tx1,ty1,tx2,ty2,7)
end

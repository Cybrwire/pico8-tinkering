version 43
__lua__
function _init()
	make_player()
end

function _update()
	update_plr()
end

function _draw()
	cls()
	map()
	draw_plr()
	_debug()
end
-->8
--collision
function move(a)
  local speed = 1
  local newx = a.x
  local newy = a.y
  local collided = false

  -- input
  if (btn(0)) newx -= speed
  if (btn(1)) newx += speed
  if (btn(2)) newy -= speed
  if (btn(3)) newy += speed

  -- try moving horizontally
  if not solid_area(newx,a.y,a.w,a.h) then
    a.x = newx
  else
    collided = true
  end

  -- try moving vertically
  if not solid_area(a.x,newy,a.w,a.h) then
    a.y = newy
  else
    collided = true
  end

end

function solid_area(x,y,w,h) --checks 4 crns of rect
  return
    solid(x,y) or-- top-left
    solid(x+w,y) or-- top-right
    solid(x,y+h) or-- bottom-left
    solid(x+w,y+h) -- bottom-right
end


function solid(x,y) --checks one point
  -- convert from pixel to tile coords
  local tx = flr(x/8)
  local ty = flr(y/8)

  local val = mget(tx, ty)
  return fget(val, 0)  -- flag 0 = solid
end

-->8
--player

function make_player()
	p={x=24,y=16,sp=1,w=6,h=6}
	
end

function draw_plr()
	spr(p.sp,p.x,p.y)
end

function update_plr()
	move(p)
end

-->8
--debug
function _debug()
  print("px: "..p.x,1,100,7)
  print("py: "..p.y,1,107,7)
  
  -- choose color: red if colliding, white if not
  local clr
  if solid_area(p.x,p.y,p.w,p.h) then
    clr = 8   -- red
  else
    clr = 7   -- white
  end

  -- draw the 4 corners of the player's hitbox
  pset(p.x,     p.y,     clr) -- top-left
  pset(p.x+7,   p.y,     clr) -- top-right
  pset(p.x,     p.y+7,   clr) -- bottom-left
  pset(p.x+7,   p.y+7,   clr) -- bottom-right
end

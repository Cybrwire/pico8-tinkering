pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	make_char()
	make_laser()

end

function _update()
	move_player()
	move_laser()
end

function _draw()
	cls()
	draw_map()
	draw_char()
	draw_laser()
	if (text) then
		
		print(text,10,10,0)
	end
end
-->8
--character code
function make_char()
	c={}
	c.spr=1
	c.x=64
	c.y=64
	c.speed=3.1
end

function draw_char()
	spr(c.spr,c.x,c.y)
end

function move_player()
	newx=0
	newy=0

	if (btnp(⬆️)) newy-=c.speed
	if (btnp(⬇️)) newy+=c.speed
	if (btnp(⬅️)) newx-=c.speed
	if (btnp(➡️)) newx+=c.speed
	
	if (newx*newy!=0) then
		newx*=0.75
		newy*=0.75
	end
	
	c.x+=newx
	c.y+=newy
end
-->8
--map code
function map_setup()
 
end

function draw_map()
	map(0,0,0,0,128,128)
end
-->8
--laser code
function make_laser()
	l={}
	l.x=32
	l.y=100
	l.spr=17
	l.move=false
	l.range=15
	l.speed=.5
end

function draw_laser()
	spr(l.spr,l.x,l.y)
end

function move_laser()
	
	dx=c.x-l.x
	dy=c.y-l.y
	
	--tracking line
	tl=sqrt(dx*dx+dy*dy)
	
	if (tl<l.range) then
		text="detected"
		l.x+=dx/l.range
		l.y+=dy/l.range
	else
		text=nil
		l.x+=cos(t()/2)
		l.y+=sin(t()/2)
		
	end
	
end

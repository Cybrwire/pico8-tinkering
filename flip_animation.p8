pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	t=0
	entities={}
	make_entity(4,1,4,1,1,12)--player
	p=entities[1]
	make_entity(3,7,3,1,1,6) --enemy
	
 make_entity(32,3,2,2,2,24) --trees
 make_entity(32,8,2,2,2,20)
	make_entity(32,8,5,2,2,15)
	make_entity(32,13,2,2,2,24)
	make_entity(32,13,5,2,2,21)
	make_entity(32,3,9,2,2,23)
	make_entity(32,5,10,2,2,15)
	make_entity(32,7,11,2,2,20)
	make_entity(32,14,12,2,2,20)
	make_entity(32,1,13,2,2,20)
	

end

function _update()
	t+=1
	animate(entities)
	move(p)
end

function _draw()
	cls()
	draw_map(p)
	draw_entity(entities)
	
	
	
end
-->8
--entities
function make_entity(_sp,_x,_y,_w,_h,_ansp)
	_e={
		sp=_sp,
		x=_x,
		y=_y,
		w=_w,
		h=_h,
		ani=false,
		ansp=_ansp --ani speed
	}
	add(entities,_e)
end

function draw_entity(en)
	for i in all(en) do
		spr(i.sp,i.x*8,i.y*8,i.w,i.h,i.ani)
	end
	
end

function animate(en) --sprite
	local e=en
	
	for i in all(e) do
		if t%i.ansp==0 then
			i.ani=not i.ani
		end
	end
	
end


-->8
--map code
function draw_map(p)
	mapx=flr(p.x/16)*16
	mapy=flr(p.y/16)*16
	camera(mapx*8,mapy*8)
	
	map(0,0,0,0,128,64)
end
-->8
--collision
function move(a)
  local speed = 1
  local newx = a.x
  local newy = a.y
  local collided = false

  -- input
  if (btnp(0)) newx -= speed
  if (btnp(1)) newx += speed
  if (btnp(2)) newy -= speed
  if (btnp(3)) newy += speed

  -- try moving horizontally
  if not solid_area(newx,a.y,a.w,a.h) then
    a.x = newx
  else
    collided = true
  end

  -- try moving vertically
  if not solid_area(a.x,newy,a.w,a.h) then
    a.y = newy
  else
    collided = true
  end

end

function solid_area(x,y,w,h) --checks 4 crns of rect
  return
    solid(x,y)   or-- top-left
    solid(x+w,y) or-- top-right
    solid(x,y+h) or-- bottom-left
    solid(x+w,y+h) -- bottom-right
end


function solid(x,y) --checks one point
  -- convert from pixel to tile coords
  local tx = flr(x/8)
  local ty = flr(y/8)

  local val = mget(tx, ty)
  return fget(val, 0)  -- flag 0 = solid
end


--player

function make_player()
	p={}
	p.x=2*8
	p.y=5*8
	p.spr=1
	p.grv=.1
	p.speed=1
	p.momentum=0
	add(players,p)
end

function uplr()
	move(p)
	

end

function draw_player()
	spr(p.spr,p.x,p.y)
end

function move_player()
	
	
end

--overlay
function draw_overlay()
	rectfill(10,10,24,10,0)
	if (p.momentum>0) print(mess,12,12,7)
end

function set_text()
	if (p.momentum>0) then
		mess=p.momentum
	end
end
-->8
--collision
function move(o)--move an object
	local lx=o.x --last x pos
	local ly=o.y --last y pos
	
	if (btn(⬆️)) o.y-=1
	if (btn(⬇️)) o.y+=1
	if (btn(⬅️)) o.x-=1
	if (btn(➡️)) o.x+=1
	
	collresult=collide(o)
	-- if new pos collides, move back to las pos
	if (collresult[1]) or (collresult[3]) then
		o.y=ly
	end
	if (collresult[2]) or (collresult[3]) then
		o.x=lx
	end
end

function collide(o)
	--vert and horiz coll
	vhcoll={false,false}
	--sides/edges of sprite as tile, not pixels
	local x1=o.x/8 --left
	local y1=o.y/8 --top
	local x2=(o.x+7)/8 --right
	local y2=(o.y+7)/8 --bottom
	
	--testing 4 corners of sprite for collision
	local a=fget(mget(x1,y1),0) --top left
	local b=fget(mget(x1,y2),0) --bot left
	local c=fget(mget(x2,y2),0) --bot right
	local d=fget(mget(x2,y1),0) --top right
	
	if (a) then
		
		if (b) vhcoll[2]=true
		if (d) vhcoll[1]=true
	end
	if (b) then
		
		if (a) vhcoll[2]=true
		if (c) vhcoll[1]=true
	end
	if (c) then
		
		if (b) vhcoll[1]=true
		if (d) vhcoll[2]=true
	end
	if (d) then
	
		if (a) vhcoll[1]=true
		if (c) vhcoll[2]=true
	end
	return vhcoll
end

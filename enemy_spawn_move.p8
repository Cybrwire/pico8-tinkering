pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--game loop
function _init()
	enemies={}
	en_counter=1
end

function _update()
	spawn_new_enemy()
	move_enemy()
end

function _draw()
	cls()
	draw_map()
	draw_enemy()
end

-->8
--enemy code
function add_enemy()
	local en={}
	en.spr=17
	en.speed=1
	en.x=0*8
	en.y=6*8
	en.move=false
	add(enemies,en)
end

function move_enemy()
	if (btnp(❎))	then
		for i in all(enemies) do
			i.move = not i.move
		end
	end
	
	for i in all(enemies) do
		if (i.move) then
			i.x+=i.speed
		end
		
	end

end

function spawn_new_enemy()

	if (btnp(➡️)) and (#enemies<4) then
		add_enemy()
		en_counter+=1
	end
	
end

function draw_enemy()	
	for i in all(enemies) do
		spr(i.spr,i.x,i.y)
	end
end


-->8
--map code
function setup_map()
	
end

function draw_map()
	map(0,0,0,0,32,32)
end



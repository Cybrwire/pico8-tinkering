pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--pizza shop trials
function _init()
	poke(0x5f2d, 7)
	game_state      = 'title'
	close_time      = 2000
	tim_lim         = close_time
	clock_pos       = {x=115,y=10}
	title_crds      = {40,30}
	c_speed         = 1
	door            = {spr=1,x=40,y=20}
	pza             = {x=23,y=95,r=20,c=15}
	ingredients     = {}
	
	ingredients_spr = {48,50,52,54,56,58}
	customers = {
	 new_customer(3,64,nil,40,20,false),
	 new_customer(4,68,nil,40,20,false),
	 new_customer(5,72,nil,40,20,false),
	 new_customer(6,128,132,40,20,true),--boss
	}
	
	kids = {
		{x=40,y=21,tx=16,ty=30,spr=7},
		{x=40,y=21,tx=64,ty=30,spr=8},
	}
	
	buttons  = {
  make_ingredient_btn(80,75,1,16),--pepperoni
  make_ingredient_btn(95,75,2,18),--bell pepper
  make_ingredient_btn(80,90,3,20),--mushroom
  make_ingredient_btn(95,90,4,22),--sausage
  make_ingredient_btn(80,105,5,24),--cheese
  make_ingredient_btn(95,105,6,26),--pineapple
  
  {x=112,y=82,w=16,h=8,action=function() clear_pizza() end,spr=60},
  {x=112,y=97,w=16,h=8,action=function() undo() end,spr=44},
		{x=112,y=113,w=16,h=8,action=function() submit_pizza() end,spr=28},
	}
end

function _draw()
	cls()
	draw_shop()
	if game_state == 'title' then
		draw_title()
	elseif game_state == 'play' then
		draw_ingredients()
		draw_customers(customers[1])
		draw_customer_order(customers[1])
		draw_timer()
		if customers[1].phase=='second' then
			draw_kids(kids)
		end
		draw_cursor()
		draw_cursor_hilite()

	elseif game_state == 'gameover' or game_state == 'win' then
		draw_gameover()		
	end
	
end

function _update()

	if btn(4) and game_state == 'title' then
	 game_state = 'play'
	elseif game_state == 'play' then
		close_time -= 1
		if close_time < 0 then game_state = 'gameover' end
		mx,my=stat(32),stat(33)
		click()
		customer_move(customers[1])
		if customers[1] and customers[1].phase=='second' then
			move_kids(kids)
		end
		check_win()
	
	elseif game_state == 'win' then
		
	end
end
-->8
--draw
function draw_shop()
	rectfill(0,0,127,27,13)--back wall
	rectfill(0,28,127,65,2)--floor
	rectfill(0,66,127,127,4)--countertop
 spr(door.spr,door.x,door.y)--door
 circfill(pza.x,pza.y,pza.r,pza.c)--pizza
 circfill(pza.x,pza.y,pza.r-3,8)--sauce
	--draw buttons
	for b in all(buttons) do
        if b.id then
         spr(b.spr,b.x,b.y,2,2)
        else
         spr(b.spr,b.x,b.y,2,1)
        end
    end
end

function draw_title()
 
 local x = title_crds[1]
	for i=203,207 do
		spr(i,x,title_crds[2])
		x+=10
	end	
	local x = title_crds[1]+5
	for i=219,222 do
		spr(i,x,title_crds[2]+15)
		x+=10
	end
	print('press z', title_crds[1]+10,title_crds[2]+28,7)
end

function draw_gameover()
	local x = title_crds[1]
	for i=235,238 do
		spr(i,x,title_crds[2])
		x+=10
	end	
	local x = title_crds[1]+5
	if game_state == 'gameover' then
		for i=251,255 do
			spr(i,x,title_crds[2]+15)
			x+=10
		end
	elseif game_state == 'win' then
	 for i=248,250 do
	 	spr(i,x,title_crds[2]+15)
	 	x+=10
  end
	end
end

function draw_ingredients()
 for i in all(ingredients) do
  spr(i.spr,i.x,i.y)   
 end
end

function draw_cursor()
	spr(2,mx,my)
end

function draw_cursor_hilite()
	if clicked then
		circfill(mx,my,6,12)
	end
	clicked = false
end

function draw_customers(_c)
	
	if _c.state == 'far' or _c.state == 'leaving' then
		spr(_c.spr,_c.x,_c.y)
	elseif _c.state == 'near' then
		if _c.boss and _c.phase == 'second' then
			spr(_c.big2,_c.x-10,_c.y-23,4,4)	
			
			draw_kids()
		else 
			spr(_c.big,_c.x-10,_c.y-23,4,4)
		end
	end
	
end

function draw_customer_order(_c)
	local tally  = tally_ingredients(_c.order)
	local t      = close_time / 90
	local offset = (1/6)
	local r      = 35
	local x,y    = 120,30
	
	for id,cnt in pairs(tally) do
		if _c.state == 'near' then
			if _c.phase == 'second' then
			 x = (_c.x+cos(t+(id*offset))*r)+4
			 y = (_c.y+sin(t+(id*offset))*r)-10			  
			 spr(ingredients_spr[id],x,y)
			 print(cnt,x,y+10,7)
			else
				spr(ingredients_spr[id],x,y)
			 print(cnt,x+1,38,7)
			end	
				
				x -= 10
				
		end
	end
end

function draw_timer()
	t = (close_time / tim_lim) - .75
	line(clock_pos.x,clock_pos.y,clock_pos.x+cos(t)*5,clock_pos.y+sin(t)*5,7)
	circ(clock_pos.x,clock_pos.y,6,7)
end

function draw_kids()
 for i in all(kids) do
		spr(i.spr,i.x,i.y)
	end
end
-->8
--button controls
function click()
	if stat(34) == 1 and btn_lst == 0 then
			clicked = true
			for b in all(buttons) do
				if btn_hit(b) then
					b.action()
					break
				end
			end
	end
	btn_lst = stat(34)
end

function make_ingredient_btn(_x,_y,_id,_spr)
 return {x=_x,y=_y,w=16,h=16,id=_id,action=function() update_ingredients(_id,_spr) end,spr=_spr}
end

function btn_hit(button)
	if mx >= button.x and my >= button.y and mx <= button.x + button.w and my <= button.y + button.h then
		return true
		else return false
	end
end

function undo()
	deli(ingredients)
end

function submit_pizza()
	local p_list = {}
	for i in all(ingredients) do add(p_list,i.id) end
	
	local c  = customers[1]
	local p  = tally_ingredients(p_list)
	local o  = tally_ingredients(c.order)
	local ps = tally_size(p)
	local os = tally_size(o)
	
	if ps ~= os then return false end
	
	for id,cnt in pairs(p) do
		if cnt ~= o[id] then
			return false --pizza is wrong
		end
	end 
	
	if c.boss then
	 if c.phase == 'first' then
	 	c.state = 'leaving'
	 elseif c.phase == 'second' then
	  c.state = 'leaving'
  end
	else c.state = 'leaving'
	end
	clear_pizza()
end


-->8
--gameplay
function xy_on_pizza()
	return pza.x + rnd(15) * cos(rnd(1)), pza.y + rnd(15) * sin(rnd(1))
end

function update_ingredients(_id)
 local x,y = xy_on_pizza()	
 add(ingredients,{id=_id,x=x,y=y,spr=ingredients_spr[_id]})
end

function tally_ingredients(_list)
	local tally = {}
	for i in all(_list) do
		if tally[i] then
			tally[i] += 1
		else 
			tally[i] = 1
		end
	end
	
	return tally
end

function tally_size(_tally)
	local _count = 0
	for _ in pairs(_tally) do
		_count += 1
	end
	
	return _count
end

function clear_pizza()
	ingredients = {}
end

function check_win()
	if #customers == 0 and close_time > 0 then
		game_state = 'win'
	end
end
-->8
--customers
function new_customer(_spr,_big,_big2,_x,_y,_boss)	
	local c = {}
	
	if _boss then
		c = {spr=_spr,big=_big,big2=_big2,x=_x,y=_y,ty=57,t=30,state='far',speed=c_speed,boss=_boss,phase='first'}
	else 
		c = {spr=_spr,big=_big,x=_x,y=_y,ty=57,t=30,state='far',speed=c_speed,boss=_boss}
	end
	
	local _order = new_order(c)
	c.order = _order
	return c 
end

function new_order(_c)

	if _c.boss then
		 if _c.phase == 'first' then
				size = flr(rnd(5)+13)
			elseif _c.phase == 'second' then
				size = flr(rnd(5)+20)
			end
	else
		size = flr(rnd(10)+5)
	end
	local order = {}
	for i = 1,size do
		add(order, flr(rnd(6)+1))
	end
	return order
end

function customer_move(_c)
	
	if _c then
		if _c.state == 'far' then
			if _c.y < _c.ty then
				_c.y     += _c.speed
			else
					_c.state = 'near'
			end
		elseif _c.state == 'leaving' then
			if _c.y > door.y then
				_c.y    -= _c.speed
			elseif _c.y <= door.y then
				_c.state = 'waiting'
				_c.t     = 30
			end
		elseif _c.state == 'waiting' then
			if _c.phase ~= 'second' then
				if _c.t > 0 then
					_c.t-=1
					
				else 
					if _c.boss then
						_c.state = 'far'
						_c.phase = 'second'
						_c.order = new_order(_c)
					else
						remove_customer()
					end
				end
			else
				remove_customer()
			end
		end
		
	end
	
end

function move_kids(_k)
	if _k[1].x > _k[1].tx then
		_k[1].x-=c_speed
	elseif _k[1].y < _k[1].ty then
		_k[1].y+=c_speed
	end

	if _k[2].x < _k[2].tx then
		_k[2].x+=c_speed
	elseif _k[2].y < _k[2].ty then
		_k[2].y+=c_speed
	end
end

function remove_customer()
	deli(customers,1)
end

--pizza shop
function _init()
	ingredients = {1,2,3,4,5,6}
	buttons = {
		{x=80,y=75,w=16,h=16,action=function() add_ingredient(1) end},
		{x=95,y=75,w=16,h=16,action=function() add_ingredient(2) end},
		{x=80,y=90,w=16,h=16,action=function() add_ingredient(3) end},
		{x=95,y=90,w=16,h=16,action=function() add_ingredient(4) end},
		{x=80,y=105,w=16,h=16,action=function() add_ingredient(5) end},
		{x=95,y=105,w=16,h=16,action=function() add_ingredient(6) end},
		{x=95,y=105,w=16,h=16,action=function() undo() end},
		{x=95,y=105,w=16,h=16,action=function() submit_pizza() end},
	}
end

function _draw()
	cls()
	draw_shop()
end

function _update()
	click()
end
-->8
function draw_shop()
	rectfill(0,0,127,27,13)--back wall
	rectfill(0,28,127,65,2)--floor
	rectfill(0,66,127,127,4)--countertop
 spr(1,40,20)--door
	circfill(23,95,20,15)--pizza
 spr(16,80,75,2,2)--pepperoni
 spr(18,95,75,2,2)--bell pepper
 spr(20,80,90,2,2)--mushroom
 spr(22,95,90,2,2)--sausage
 spr(24,80,105,2,2)--cheese
 spr(26,95,105,2,2)--pineapple
 spr(28,112,97,2,1)--submit
 spr(44,112,113,2,1)--undo

end

-->8
function click()
		
end

function select_ingredient()
	col   = (mx - panel_x) \ cell_width
	row   = (my - panel_y) \ cell_height
	index = (row * 2) + col + 1
	ingredient = ingredients[index]
end

function click()
	mx,my = stat(32),stat(33)
	
end

function btn_hit(button)
	if mx >= button.x and my >= button.y and mouse_x <= button.x + button.w and mouse_y <= button.y + button.h then
		return true
		else return false
	end
end

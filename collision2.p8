pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--game loop
function _init()
	player=create_entity(2,5)
end

function _update()
	control_player(player)
	foreach(entities,update_entity)
end

function _draw()
	cls()
	map(0,0,0,0,32,32)
	foreach(entities,draw_entity)
	
end
-->8
--entities code
entities={}
function create_entity(x,y)
	e={}
	e.x=x
	e.y=y
	e.spr=16
	accel=0.1
	--entity hitbox
	e.half_w=0.4
	e.half_h=0.4
	
	add(entities,e)
	return e
end

function draw_entity(e)
	local px=(e.x*8)
	local py=(e.y*8)
	spr(e.spr,px,py)
end


function update_entity(e) -- update entity movement and collisions
	local newx=e.x
	local newy=e.y
	 
 if (btn(⬅️)) newx-=accel
	if (btn(➡️)) newx+=accel
	if (btn(⬆️)) newy-=accel
	if (btn(⬇️)) newy+=accel
 
 -- horizontal check (x axis)
	if not is_colliding(e.x + e.vx, e.y, e.half_w, e.half_h) then
		e.x = -- no collision, so apply movement
	else 
		sfx(2) -- collision! 
	end


 -- vertical check (y axis)
	if not is_colliding(e.x, e.y + e.vy, e.half_w, e.half_h) then
		e.y += e.vy
	else
		sfx(2)
	end

end

function is_solid(tile_x, tile_y) -- check if a given map cell is solid
	local tile_id = mget(tile_x, tile_y)
	return fget(tile_id, 1) --check for wall flag
end


function is_colliding(x, y, half_w, half_h) -- check if an entityヌ█▥s bounding box collides with solid tiles
 -- check the four corners of the rectangle, return true if colliding
	return 
		is_solid(x - half_w, y - half_h) or -- top-left
		is_solid(x + half_w, y - half_h) or -- top-right
		is_solid(x - half_w, y + half_h) or -- bottom-left
		is_solid(x + half_w, y + half_h)    -- bottom-right
end

